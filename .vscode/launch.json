{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug API - NestJS",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug", "--", "--app", "api"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "restart": true
    }
  ]
}
